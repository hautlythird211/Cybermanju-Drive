{"type": "project_overview", "name": "Cybermanju Drive", "version": "0.1.0", "description": "Quantum-resistant encrypted file manager with AI face grouping, triple-layer compression, code intelligence, GPS map view, web dashboard, multi-user access control, and cross-platform cloud sync. Runs as Tauri v2 desktop app, Docker container with web dashboard, or WASM/GitHub Pages.", "license": "MIT", "identifier": "com.cybermanju.drive"}
{"type": "deployment_modes", "modes": [
  {"name": "Tauri Desktop", "entry": "src-tauri/src/main.rs", "transport": "Tauri IPC (invoke)", "use_case": "Native desktop with full filesystem access, 60+ IPC commands via Conduit plugin"},
  {"name": "Web Dashboard", "entry": "Embedded HTTP on 0.0.0.0:3456", "transport": "REST API (fetch)", "use_case": "Browser access from any device; Docker/ZimaOS NAS deployment"},
  {"name": "WASM/GitHub Pages", "entry": "dist-wasm/ static files", "transport": "SPA + WASM bridge via IndexedDB", "use_case": "Public showcase, read-only demo, no backend required"}
]}
{"type": "workspace_layout", "root": "Cargo.toml [workspace]", "members": [
  "crates/types", "crates/crypto", "crates/compression", "crates/search",
  "crates/db", "crates/portable-db", "crates/web", "crates/faces",
  "crates/tests", "crates/drive-wasm", "crates/cli", "crates/backends", "src-tauri"
], "resolver": "2"}
{"type": "crate", "name": "cybermanju-types", "path": "crates/types", "description": "Shared data types used by all crates and the Tauri app", "dependencies": ["serde", "serde_json"], "exports": ["FileNode", "Account", "Collection", "CollectionItem", "FaceGroup", "EncryptionKey", "LooseGroup", "User", "UserFilePermission", "Location", "TrashItem", "AuditEntry", "FileVersion", "ShareLink", "FileRelation", "DeletionRecord", "RecoveryEntry", "PortableHeader", "ContentStoreEntry", "PreviewStoreEntry", "SyncBackendType", "SyncStatus", "CloudAccount", "OAuthCredentials", "SyncFile", "SyncConfig", "SyncProgress", "SyncResult", "RemoteFile", "StorageBackend trait"], "used_by": ["db", "crypto", "faces", "backends", "portable-db", "tests", "cli", "src-tauri", "drive-wasm"]}
{"type": "crate", "name": "cybermanju-crypto", "path": "crates/crypto", "description": "Post-quantum cryptography engine. Real ML-KEM (FIPS 203), ML-DSA (FIPS 204), Hybrid ML-KEM-768+X25519, ChaCha20Poly1305 AEAD, HMAC-SHA512.", "dependencies": ["anyhow", "base64", "blake3", "chacha20poly1305", "chrono", "hkdf", "hmac", "ml-dsa", "pqcrypto-mlkem", "pqcrypto-traits", "rand_core", "serde/serde_json", "sha2", "signature", "uuid", "x25519-dalek"], "exports": ["EncryptionAlgo enum (Kyber1024/Hybrid/MlDsa44-65-87/ClassicalSign/Aes256)", "KeyPair", "FileEncryptedData", "EncryptionStatus", "PqcEngine (generate_keypair/list_keys/encrypt/decrypt/sign/verify)", "encrypt_data", "decrypt_data", "sign_message", "verify_signature", "algorithm_from_str", "EncryptedFileMeta"], "used_by": ["portable-db", "drive-wasm", "src-tauri"]}
{"type": "crate", "name": "cybermanju-compression", "path": "crates/compression", "description": "Triple-layer compression pipeline: LZ4 (ultra-fast) → Zstd (balanced) → Brotli (max ratio). Supports individual layers or full triple cascade. Skips remaining layers if LZ4 ratio > 0.98 (incompressible data).", "dependencies": ["anyhow", "blake3", "lz4_flex", "serde", "zstd", "brotli", "log"], "modules": ["layers/lz4.rs", "layers/zstd_layer.rs", "layers/brotli_layer.rs", "triple.rs", "types.rs"], "exports": ["TripleCompressor (compress_lz4/decompress_lz4/compress_zstd/decompress_zstd/compress_brotli/decompress_brotli/compress_data/compress_triple/decompress_triple)", "Lz4Layer", "ZstdLayer", "BrotliLayer", "CompressionType enum (None/Lz4/Zstd/TripleLayer)", "CompressionStats", "LayerDetail"], "used_by": ["portable-db", "drive-wasm", "tests", "cli", "src-tauri"]}
{"type": "crate", "name": "cybermanju-search", "path": "crates/search", "description": "Tantivy full-text search index with BM25 ranking, faceted search, fuzzy matching, and real term dictionary completions. Indexes filename, content_text, tags, file_type, is_encrypted, has_geo, timestamp, blake3_hash.", "dependencies": ["anyhow", "chrono", "serde", "tantivy"], "exports": ["SearchIndex (new/add_document/add_document_batch/add_document_no_commit/commit/remove_document/delete_term/search/search_with_count/suggest/doc_count)", "SearchResult", "SearchRequest", "SearchSuggestion", "DocumentParams"], "used_by": ["web", "tests", "src-tauri"]}
{"type": "crate", "name": "cybermanju-db", "path": "crates/db", "description": "redb (embedded key-value store) database layer with 20+ tables and parent index for hierarchical file organization. Stores files, accounts, collections, face groups, encryption keys, locations, users, permissions, sync configs, trash, audit log, file versions, share links, portable DB metadata.", "dependencies": ["anyhow", "base64", "chrono", "cybermanju-types", "rand_core", "redb", "serde/serde_json", "uuid"], "exports": ["Database (new/begin_read/begin_write/log_audit/trash_file/restore_from_trash/list_trash/empty_trash/create_file_version/list_file_versions/revert_file_version/create_share_link/get_share_link_by_token/get_file_node/add_to_parent_index/remove_from_parent_index/list_by_parent/insert_file_with_index/remove_file_with_index/move_file_with_index)", "Also: store_file_relation/get_file_relation/get_file_relations_for_local/delete_file_relation/list_all_file_relations/store_deletion_record/get_deletion_record/list_pending_deletions/list_all_deletion_records/update_deletion_record/delete_deletion_record/store_recovery_entry/get_recovery_entry/list_all_recovery_entries/delete_recovery_entry/set_portable_meta/get_portable_meta/get_all_portable_meta/mark_deletion_propagated/update_file_relation_status)", "FILE_CONTENTS_TABLE", "ContentLocation enum"], "used_by": ["portable-db", "tests", "cli", "src-tauri"]}
{"type": "crate", "name": "cybermanju-portable-db", "path": "crates/portable-db", "description": ".cybermanju portable database — a self-contained, triple-compressed, optionally encrypted redb database for cross-platform file relations, deletion propagation, and recovery. One .cybermanju file per user, synced to every connected platform. Binary format: [32B magic][4B header_len][header JSON][compressed_db]. Blobs stored in sidecar .cyb3 directory.", "dependencies": ["anyhow", "blake3", "chrono", "cybermanju-compression", "cybermanju-crypto", "cybermanju-db", "cybermanju-types", "log", "serde/serde_json", "uuid"], "exports": ["PortableDatabase (create/open/open_or_create/pack/unpack/store_compressed_content/store_preview/get_recoverable_data/get_preview_data/list_recoverable_files/delete_recovery_entry/sync_to_backend/sync_from_backend/record_file_relation/record_deletion/propagate_deletion/repack/header/path)"], "used_by": ["cli", "src-tauri"]}
{"type": "crate", "name": "cybermanju-web", "path": "crates/web", "description": "Web browser engine with tab management, DuckDuckGo search (via scraper reqwest), HTML renderer (text extraction, title, links), and Tantivy hybrid search. WASM-compatible (uses web-sys fetch when target_arch=wasm32).", "dependencies": ["serde", "serde_json", "url", "scraper", "log", "uuid", "chrono", "anyhow", "thiserror", "async-trait", "native: reqwest+tokio+cybermanju-search", "wasm32: wasm-bindgen+serde-wasm-bindgen+js-sys+web-sys+reqwest"], "modules": ["browser/manager.rs", "browser/mod.rs", "search/duckduckgo.rs", "search/tantivy.rs", "search/mod.rs", "render/html.rs", "render/layout.rs", "render/mod.rs", "wasm/mod.rs"], "exports": ["BrowserManager (open_tab/close_tab/activate_tab/navigate/add_history/add_bookmark/remove_bookmark/search_history)", "SearchEngine trait", "DuckDuckGoEngine", "HtmlRenderer (extract_text/extract_title/extract_links)", "WasmSearch (wasm_bindgen)", "WasmBrowser (wasm_bindgen)", "Tab/HistoryEntry/Bookmark/BrowserSettings", "SearchQuery/SearchResponse/SearchSourceType/SearchError", "WebResult"], "used_by": ["src-tauri"]}
{"type": "crate", "name": "cybermanju-faces", "path": "crates/faces", "description": "Face detection and clustering module. 4 clustering algorithms: BruteForce O(n²), SimHash-accelerated LSH, Chinese Whispers (graph label propagation), HDBSCAN (MST-based hierarchical density). SimHash with 64-bit binary codes + 3 LSH tables for ~97% recall at cosine distance 0.3. ONNX integration for SCRFD detection + ArcFace embeddings (optional feature). Auto-selects algorithm based on dataset size.", "dependencies": ["anyhow", "blake3", "cybermanju-types", "log", "rayon", "serde/serde_json", "optional: ort/image/reqwest/ndarray/dirs"], "exports": ["EMBEDDING_DIM (512)", "HASH_BITS (64)", "DEFAULT_MATCH_THRESHOLD (0.55)", "SimHashIndex (new/query_candidates/knn/range_query)", "to_binary_hash", "hamming_distance", "embedding_distance", "embedding_distance_batch", "adaptive_threshold", "find_medoid", "update_medoid_incremental", "UnionFind", "cluster_bruteforce", "cluster_simhash", "cluster_chinese_whispers", "cluster_hdbscan", "cluster_auto (auto-selects algorithm)", "ClusteringStrategy enum", "Cluster type", "cached_projections"], "used_by": ["src-tauri"]}
{"type": "crate", "name": "cybermanju-drive-wasm", "path": "crates/drive-wasm", "description": "WASM bridge exposing Rust crypto, compression, virtual drive, and sync engine to browser JavaScript via wasm-bindgen. Pure Rust dependencies (no C bindings) for browser compatibility.", "dependencies": ["wasm-bindgen", "js-sys", "serde-wasm-bindgen", "blake3", "chacha20poly1305", "sha2", "hkdf", "hmac", "ml-dsa", "ml-kem", "x25519-dalek", "signature", "rand_core", "getrandom_v0_2", "getrandom", "lz4_flex", "brotli", "zstd", "serde/serde_json", "uuid", "chrono", "wasm-logger", "log"], "modules": ["crypto.rs", "compression.rs", "drive.rs", "sync.rs", "types.rs"], "exports (wasm_bindgen)": ["init", "generate_uuid", "now_utc", "hash_file_meta", "crypto: blake3_hash/chacha20_generate_key/chacha20_generate_nonce/chacha20_encrypt/chacha20_decrypt/hkdf_derive/hmac_sha512/x25519_generate_keypair/x25519_shared_secret/ml_dsa65_generate_keypair/ml_dsa65_sign/ml_dsa65_verify/ml_kem1024_generate_keypair/ml_kem1024_encapsulate/ml_kem1024_decapsulate", "compression: compress_lz4/decompress_lz4/compress_brotli/decompress_brotli/compress_zstd/decompress_zstd/compress_lz4_probe_ratio", "drive: VirtualDrive (create_file/delete_file/get_file/list_files/search_files/rename_file/move_file/set_file_size/set_file_tags/toggle_star/get_starred_files/get_geo_files/get_quota/get_all_files/to_json/from_json)", "sync: SyncEngine (add_file/mark_synced/mark_error/mark_changed/remove_file/get_entries/get_state/get_pending_count/get_error_count/get_synced_count/has_changes/reset/to_json/from_json)"], "used_by": ["JavaScript frontend via import('cybermanju-drive-wasm')"]}
{"type": "crate", "name": "cybermanju-backends", "path": "crates/backends", "description": "Shared storage backend implementations for cloud sync. Each backend implements the StorageBackend trait.", "dependencies": ["cybermanju-types", "serde/serde_json", "reqwest (blocking/json/multipart)", "base64", "chrono", "log", "urlencoding", "megalib", "tokio"], "modules": ["local.rs", "github.rs", "gitlab.rs", "google_drive.rs", "google_photos.rs", "telegram.rs", "mega.rs", "transfer.rs", "util.rs"], "exports": ["LocalBackend", "GitHubBackend", "GitLabBackend", "GoogleDriveBackend", "GooglePhotosBackend", "TelegramBackend", "MegaBackend", "transfer_files", "ProgressCallback", "TransferProgress"], "used_by": ["cli", "src-tauri"]}
{"type": "crate", "name": "cybermanju-cli", "path": "crates/cli", "description": "CLI/TUI application with clap argument parsing and ratatui terminal UI. Supports harvest (scan files), transfer (cross-backend file copy), portable DB operations, and backend management.", "dependencies": ["cybermanju-types", "cybermanju-crypto", "cybermanju-compression", "cybermanju-db", "cybermanju-portable-db", "cybermanju-backends", "clap", "anstyle", "ratatui", "crossterm", "reqwest (blocking/json/multipart)", "urlencoding", "megalib", "anyhow", "serde/serde_json", "chrono", "uuid", "base64", "blake3", "log", "dirs"], "binary": "cybermanju (src/main.rs)", "modules": ["main.rs", "tui.rs", "harvest.rs", "transfer.rs", "backends.rs", "portable.rs"], "used_by": ["Direct CLI execution"]}
{"type": "crate", "name": "cybermanju-tests", "path": "crates/tests", "description": "Comprehensive test suite exercising all workspace crates (types, compression, crypto, db, search, web)", "dependencies": ["cybermanju-types", "cybermanju-compression", "cybermanju-crypto", "cybermanju-db", "cybermanju-search", "cybermanju-web", "serde/serde_json", "anyhow", "blake3", "redb", "tempfile"], "used_by": ["cargo test --workspace"]}
{"type": "crate", "name": "cybermanju-drive (src-tauri)", "path": "src-tauri", "description": "Tauri v2 desktop application — the primary deployment target. Orchestrates all workspace crates, registers 60+ IPC commands, manages AppState (db, search index, compressor), runs the embedded web dashboard, and initializes Tauri plugins.", "dependencies": ["All workspace crates (types/crypto/compression/search/db/portable-db/faces/backends)", "tauri v2 (tray-icon)", "tauri plugins: fs, dialog, shell, notification, store, log, os, process", "tauri-plugin-conduit (2.4x faster IPC)", "tauri-plugin-serialplugin", "serde/serde_json/anyhow/chrono/uuid/blake3/log/tracing/base64/rand_core", "redb, argon2, jsonwebtoken, hmac, sha2, hex", "kamadak-exif, image, infer, mime_guess", "reqwest (blocking/json/multipart/rustls-tls), url, scraper, megalib, tokio", "dirs, sysinfo, walkdir, rayon", "optional: tauri-plugin-snap-layout (windows), tauri-plugin-clipboard-next (non-android)"], "lib_type": "staticlib + cdylib + rlib", "features": ["default", "onnx-face (activates cybermanju-faces/onnx-face)"]}
